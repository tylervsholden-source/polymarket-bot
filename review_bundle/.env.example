# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Polymarket CLOB API
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_PRIVATE_KEY=

# ── GUVENLIK ─────────────────────────────────────────────
LIVE_TRADING_ENABLED=false        # true yapmadan once approval queue'yu test et!
MAX_ORDERS_PER_HOUR=3             # Saatlik emir limiti (rate limiter)
READINESS_MAX_AGE_HOURS=12        # Readiness verdict max yasi (saat)

# ── ANA BOT AYARLARI ──────────────────────────────────────
INITIAL_CAPITAL=1000
MAX_POSITION_PCT=0.20
DAILY_STOP_LOSS_PCT=0.15
MAX_OPEN_POSITIONS=3          # Uzmanlaşma: 5'ten 3'e düşürüldü
CYCLE_INTERVAL_SECONDS=300

# ── KALITE FILTRESI (araştırma: >%75 win rate) ────────────
# Kaynak: 112,000 Polymarket adresi analizi + SSRN 2025
MIN_EDGE_THRESHOLD=0.12       # 0.05 → 0.12 (+%72-78 win rate)
MIN_MARKET_VOLUME=10000       # 5000 → 10000 (daha iyi fiyat keşfi)
QUALITY_PRICE_MIN=0.55        # Fiyat sweet spot alt sınırı
QUALITY_PRICE_MAX=0.88        # Fiyat sweet spot üst sınırı
REQUIRE_HIGH_CONFIDENCE=true  # Sadece HIGH güvenli sinyaller
REQUIRE_WHALE_ALIGNMENT=true  # Whale karşı yönde ise geç (+5-8%)
REQUIRE_CONSENSUS_ALIGNMENT=true  # AI + hedge fund aynı yönde olmalı
MIN_HOURS_TO_CLOSE=4          # Kapanışa min 4 saat (optimal pencere)
MAX_HOURS_TO_CLOSE=168        # Kapanışa max 7 gün

# ── SİNYAL MODU ───────────────────────────────────────────
# ai         → Claude tek prompt (hızlı, ucuz)
# hedge_fund → 7 yatırımcı personası paralel konsensüs
# combined   → Ağırlıklı ortalama (AI:%40 + Consensus:%60) — önerilen
SIGNAL_MODE=combined

# ── MOONSHOT MODU (planktonXD stratejisi) ─────────────────
# Düşük fiyatlı (0.01-0.06) marketlerde küçük sabit pozisyon
# %99 kaybeder, 1-2 tanesi 20x-100x yapabilir
MOONSHOT_ENABLED=true
MOONSHOT_MAX_PRICE=0.06
MOONSHOT_MIN_PRICE=0.01
MOONSHOT_BET_SIZE=3
MOONSHOT_MAX_POSITIONS=25
MOONSHOT_BUDGET_PCT=0.15
MOONSHOT_MIN_VOLUME=500
